{
  "name": "psychology-of-learning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "gen:sql": "node scripts/gen-seed.mjs",
    "test": "npm run test:unit && npm run test:db && npm run test:e2e",
    "test:unit": "node --test tests/unit/data.test.mjs",
    "test:db": "node --test tests/db/schema.test.mjs",
    "test:e2e": "playwright test",
    "test:prod": "node -e \"process.env.BASE_URL='https://psychology-of-learning-nptel.vercel.app';require('child_process').execSync('npx playwright test',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/analytics": "^1.6.1",
    "motion": "12.43.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "7.9.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.3.16",
    "@playwright/test": "^1.55.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
